generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(cuid())

  name          String?
  email         String?        @unique
  phone         String?        @unique

  password      String?

  address       String?
  role          UserRole       @default(CUSTOMER)
  accountStatus AccountStatus  @default(ACTIVE)

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  bookings      Booking[]      @relation("CustomerBookings")
  savedTailors  SavedTailor[]
  tailorProfile TailorProfile?
}

model TailorService {
  id          String        @id @default(cuid())
  tailorId    String
  serviceName String
  price       Decimal       @db.Decimal(10, 2)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  tailor      TailorProfile @relation(fields: [tailorId], references: [id], onDelete: Cascade)
}

model TailorProfile {
  id          String          @id @default(cuid())
  userId      String          @unique
  shopName    String
  phone       String
  city        String
  address     String
  experience  Int
  description String?
  shopPhoto    String?         @db.Text
  workPhotos   String[]        @default([])
  isVerified  Boolean         @default(false)
  status      TailorStatus    @default(PENDING)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  bookings    Booking[]
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  services    TailorService[]
  savedBy     SavedTailor[]
}

model SavedTailor {
  id        String        @id @default(cuid())
  userId    String
  tailorId  String
  createdAt DateTime      @default(now())
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  tailor    TailorProfile @relation(fields: [tailorId], references: [id], onDelete: Cascade)

  @@unique([userId, tailorId])
  @@index([userId])
}

model Booking {
  id             String        @id @default(cuid())
  customerId     String
  tailorId       String
  bookingDate    DateTime
  address        String
  notes          String?
  status         BookingStatus @default(PENDING)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  quotationNotes String?
  quotationPrice Decimal?      @db.Decimal(10, 2)
  customer       User          @relation("CustomerBookings", fields: [customerId], references: [id], onDelete: Cascade)
  tailor         TailorProfile @relation(fields: [tailorId], references: [id], onDelete: Cascade)
}

enum BookingStatus {
  PENDING
  ACCEPTED
  IN_PROGRESS
  REJECTED
  COMPLETED
  CANCELLED
  QUOTATION_SENT
  CONFIRMED
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
}

enum TailorStatus {
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}
